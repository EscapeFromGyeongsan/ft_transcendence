PORT=3001
# Local development only. Set these before starting the DB container.
POSTGRES_USER=cafe
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=cafe_dev
POSTGRES_PORT=5432
# Match the settings above; percent-encode special characters in URL credentials.
DATABASE_URL=postgresql://cafe:local-development-only@127.0.0.1:5432/cafe_dev
# Signs access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# Separate disposable DB for integration tests (npm test). Tests wipe its data.
TEST_DATABASE_URL=postgresql://cafe:local-development-only@127.0.0.1:5432/cafe_test
# Shared password for qa-p1~p4 and qa-outsider (npm run qa:accounts). Private test env only.
QA_PASSWORD=change-me-qa-password
# Encrypts 2FA (TOTP) secrets. Without it the 2FA endpoints return 503.
# Generate with: openssl rand -base64 48. Changing it invalidates every 2FA setup.
TWO_FACTOR_KEY=change-me-to-a-random-string-of-32-plus-chars
# 42 Intra OAuth app (https://profile.intra.42.fr/oauth/applications). Set all three or none.
# Redirect URI must match the app settings and point to the web callback page.
FT_OAUTH_CLIENT_ID=
FT_OAUTH_CLIENT_SECRET=
FT_OAUTH_REDIRECT_URI=
# Proxies whose X-Forwarded-For is trusted for client IP (rate limit). Default: loopback.
# Behind the Docker Nginx use: uniquelocal
TRUST_PROXY=loopback
