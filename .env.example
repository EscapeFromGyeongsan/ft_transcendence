# One settings file for `make` (Docker, infra/compose.full.yaml) and for local
# development (make dev, make test). `make` or `make prepare` copies this to
# .env when it is missing and fills the empty JWT_SECRET and TWO_FACTOR_KEY.
# Keep .env private; it is ignored by Git and Docker builds.

# --- Shared by make and local development ---
# Signs access tokens. 32+ characters, e.g. openssl rand -hex 32.
# Changing it invalidates issued tokens.
JWT_SECRET=
# Encrypts 2FA (TOTP) secrets. Empty disables the 2FA endpoints (503).
# Changing it invalidates every 2FA setup.
TWO_FACTOR_KEY=
# 42 Intra OAuth app (https://profile.intra.42.fr/oauth/applications). Set all three or none.
# `make` always uses https://<address>:<HTTPS_PORT>/oauth/42/callback and prints it.
# FT_OAUTH_REDIRECT_URI is used only by local development and must match the app settings.
FT_OAUTH_CLIENT_ID=
FT_OAUTH_CLIENT_SECRET=
FT_OAUTH_REDIRECT_URI=

# --- make only ---
# The DB password lives in this file; Compose passes it as a Docker secret.
POSTGRES_PASSWORD_FILE=./infra/secrets/postgres-password
CERT_DIR=./infra/certs
# `make` binds 0.0.0.0 on this computer's IP and `make local` binds 127.0.0.1
# for each run; BIND_ADDRESS is used only when running docker compose directly.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Local development only (make ignores these) ---
PORT=3001
# Database container of make dev/test/e2e (or `npm run db:up`). Set these before its first start.
POSTGRES_USER=cafe
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=cafe_dev
POSTGRES_PORT=5432
# Match the settings above; percent-encode special characters in URL credentials.
DATABASE_URL=postgresql://cafe:local-development-only@127.0.0.1:5432/cafe_dev
# Separate disposable DB for integration tests (make test creates cafe_test and points the container at it). Tests wipe its data.
TEST_DATABASE_URL=postgresql://cafe:local-development-only@127.0.0.1:5432/cafe_test
# Shared password for qa-p1~p4 and qa-outsider (make qa-accounts, make dev-qa-accounts). Private test env only.
QA_PASSWORD=change-me-qa-password
# Proxies whose X-Forwarded-For is trusted for client IP (rate limit). Default: loopback.
TRUST_PROXY=loopback
# Uploaded avatar files. Relative paths start from the project root. Default: data/avatars
AVATAR_DIR=data/avatars
