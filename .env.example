PORT=3001
# Local development only. Set these before starting the DB container.
POSTGRES_USER=cafe
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=cafe_dev
POSTGRES_PORT=5432
# Match the settings above; percent-encode special characters in URL credentials.
DATABASE_URL=postgresql://cafe:local-development-only@127.0.0.1:5432/cafe_dev
# Signs access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# Separate disposable DB for integration tests (npm test). Tests wipe its data.
TEST_DATABASE_URL=postgresql://cafe:local-development-only@127.0.0.1:5432/cafe_test
