# Copy to .env.full. This file is for infra/compose.full.yaml only.
# Passwords live in a file; do not put them in this file or DATABASE_URL.
POSTGRES_USER=cafe
POSTGRES_DB=cafe_full
POSTGRES_PASSWORD_FILE=./infra/secrets/postgres-password
CERT_DIR=./infra/certs

# Default exposure is local only. LAN access needs an explicit binding change
# and a certificate valid for the address used by the other computer.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
