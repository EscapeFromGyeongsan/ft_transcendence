# Copy to .env.full. This file is for infra/compose.full.yaml only.
# Passwords live in a file; do not put them in this file or DATABASE_URL.
POSTGRES_USER=cafe
POSTGRES_DB=cafe_full
POSTGRES_PASSWORD_FILE=./infra/secrets/postgres-password
CERT_DIR=./infra/certs

# API settings for the server/auth and avatar integration (PRs #11 and #15).
# Required: generate a private value with openssl rand -hex 32 (32+ characters).
JWT_SECRET=
# Optional 2FA encryption key: leave empty to disable the 2FA endpoints.
# Changing a configured key invalidates existing 2FA setups.
TWO_FACTOR_KEY=
# Optional 42 OAuth: set all three values or leave all three empty.
FT_OAUTH_CLIENT_ID=
FT_OAUTH_CLIENT_SECRET=
FT_OAUTH_REDIRECT_URI=
# Trust the private Docker Nginx peer. The proxy replaces incoming X-Forwarded-For.
TRUST_PROXY=uniquelocal
# Compose fixes AVATAR_DIR to /data/avatars and mounts its own avatars volume.

# `make` binds 0.0.0.0 on this computer's IP and `make local` binds 127.0.0.1
# for each run; this value is used only when running docker compose directly.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
