+    '{"type":"ping"}',
+    '{"type":"ping","payload":[]}',
+    '{"type":"ping","requestId":"","payload":{}}',
+    `{"type":"ping","requestId":"${"r".repeat(65)}","payload":{}}`,
+  ]) {
