--- /dev/null
+++ b/apps/server/src/services/connection-registry.test.ts
@@ -0,0 +1,104 @@
+import { describe, expect, test, vi } from "vitest";
+import type { WebSocket } from "ws";
+import { createConnectionRegistry } from "./connection-registry.ts";
+
+function fakeSocket() {
+  return { send: vi.fn(), close: vi.fn() } as unknown as WebSocket & {
+    send: ReturnType<typeof vi.fn>;
+    close: ReturnType<typeof vi.fn>;
+  };
+}
+
+describe("connection registry", () => {
+  test("a match broadcast reaches only that match's subscribers", () => {
+    const registry = createConnectionRegistry();
+    const [a1, a2, b1, idle] = [1, 2, 3, 4].map(fakeSocket);
+    registry.add("s1", a1);
+    registry.add("s2", a2);
+    registry.add("s3", b1);
+    registry.add("s4", idle);
+    registry.subscribe(10, 1, a1);
+    registry.subscribe(10, 2, a2);
+    registry.subscribe(20, 3, b1);
+
+    registry.broadcastUpdate(10, 1, { type: "game.updated" });
+
+    const sent = JSON.stringify({ type: "game.updated" });
+    expect(a1.send).toHaveBeenCalledExactlyOnceWith(sent);
+    expect(a2.send).toHaveBeenCalledExactlyOnceWith(sent);
+    expect(b1.send).not.toHaveBeenCalled();
+    expect(idle.send).not.toHaveBeenCalled();
+  });
+
+  test("updates never go backwards within a match", () => {
+    const registry = createConnectionRegistry();
+    const socket = fakeSocket();
+    registry.subscribe(10, 1, socket);
+
+    expect(registry.broadcastUpdate(10, 2, { v: 2 })).toBe(true);
+    expect(registry.broadcastUpdate(10, 1, { v: 1 })).toBe(false);
+    expect(registry.broadcastUpdate(10, 2, { v: 2 })).toBe(false);
+    expect(registry.broadcastUpdate(10, 3, { v: 3 })).toBe(true);
+    expect(socket.send.mock.calls).toEqual([
+      [JSON.stringify({ v: 2 })],
+      [JSON.stringify({ v: 3 })],
+    ]);
+  });
+
+  test("the last subscribing socket of a user controls the match", () => {
+    const registry = createConnectionRegistry();
+    const [tab1, tab2, opponent] = [1, 2, 3].map(fakeSocket);
+
+    expect(registry.subscribe(10, 1, tab1)).toBeUndefined();
+    expect(registry.subscribe(10, 2, opponent)).toBeUndefined();
+    expect(registry.subscribe(10, 1, tab2)).toBe(tab1);
+    expect(registry.subscribe(10, 1, tab2)).toBeUndefined();
+
+    expect(registry.isController(10, 1, tab1)).toBe(false);
+    expect(registry.isController(10, 1, tab2)).toBe(true);
+    expect(registry.isController(10, 2, opponent)).toBe(true);
+    // The replaced socket keeps watching.
+    expect(registry.isSubscribed(10, tab1)).toBe(true);
+
+    registry.unsubscribe(10, tab2);
+    expect(registry.isController(10, 1, tab2)).toBe(false);
+    expect(registry.isController(10, 2, opponent)).toBe(true);
+  });
+
+  test("unsubscribe and socket removal stop further messages", () => {
+    const registry = createConnectionRegistry();
+    const [left, closed, stays] = [1, 2, 3].map(fakeSocket);
+    for (const [i, socket] of [left, closed, stays].entries()) {
+      registry.add("s", socket);
+      registry.subscribe(10, i + 1, socket);
+    }
+    registry.subscribe(20, 2, closed);
+
+    registry.unsubscribe(10, left);
+    registry.remove("s", closed);
+    registry.broadcastUpdate(10, 1, { type: "x" });
+    registry.broadcastUpdate(20, 1, { type: "x" });
+
+    expect(left.send).not.toHaveBeenCalled();
+    expect(closed.send).not.toHaveBeenCalled();
+    expect(stays.send).toHaveBeenCalledOnce();
+    expect(registry.isSubscribed(10, left)).toBe(false);
+    expect(registry.isSubscribed(20, closed)).toBe(false);
+    expect(registry.isController(20, 2, closed)).toBe(false);
+    expect(registry.isSubscribed(10, stays)).toBe(true);
+  });
+
+  test("closeSession closes only that session's sockets", () => {
+    const registry = createConnectionRegistry();
+    const [tab1, tab2, other] = [1, 2, 3].map(fakeSocket);
+    registry.add("s1", tab1);
+    registry.add("s1", tab2);
+    registry.add("s2", other);
+
+    registry.closeSession("s1", 4401, "Session ended.");
+
+    expect(tab1.close).toHaveBeenCalledWith(4401, "Session ended.");
+    expect(tab2.close).toHaveBeenCalledWith(4401, "Session ended.");
+    expect(other.close).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/server/src/services/connection-registry.ts b/apps/server/src/services/connection-registry.ts
new file mode 100644
--- /dev/null
+++ b/apps/server/src/services/connection-registry.ts
@@ -0,0 +1,143 @@
+import type { WebSocket } from "ws";
+
+function addTo<K, V>(map: Map<K, Set<V>>, key: K, value: V) {
+  const values = map.get(key) ?? new Set<V>();
+  values.add(value);
+  map.set(key, values);
+}
+
+function deleteFrom<K, V>(map: Map<K, Set<V>>, key: K, value: V) {
+  const values = map.get(key);
+  values?.delete(value);
+  if (values?.size === 0) map.delete(key);
+}
+
+/**
+ * 인증된 WebSocket 연결을 서버 세션별·경기별로 보관하는 목록을 만듭니다.
+ *
+ * @remarks
+ * 세션별 목록은 세션이 폐기될 때(로그아웃) 그 세션의 연결을 모두 닫는 데,
+ * 경기별 목록은 경기 메시지를 그 경기를 구독한 연결에만 보내는 데 씁니다.
+ * 경기·사용자별 입력 권한 연결과 경기별 마지막 전송 버전도 함께 관리합니다.
+ * 메모리에만 있으며 API 인스턴스 1개를 전제합니다.
+ */
+export function createConnectionRegistry() {
+  const bySession = new Map<string, Set<WebSocket>>();
+  const byMatch = new Map<number, Set<WebSocket>>();
+  const matchesOf = new Map<WebSocket, Set<number>>();
+  // FR-MATCH-02: per match and user, only the socket that subscribed last
+  // may send commands (other tabs or devices keep watching).
+  const controllers = new Map<number, Map<number, WebSocket>>();
+  // Highest stateVersion broadcast per match, so updates never go backwards.
+  const sentVersions = new Map<number, number>();
+
+  function unsubscribe(matchId: number, socket: WebSocket) {
+    deleteFrom(byMatch, matchId, socket);
+    deleteFrom(matchesOf, socket, matchId);
+    const byUser = controllers.get(matchId);
+    for (const [userId, controller] of byUser ?? []) {
+      if (controller === socket) byUser!.delete(userId);
+    }
+    if (byUser?.size === 0) controllers.delete(matchId);
+    if (!byMatch.has(matchId)) sentVersions.delete(matchId);
+  }
+
+  return {
+    /** 인증에 성공한 연결을 세션에 등록합니다. */
+    add(sessionId: string, socket: WebSocket) {
+      addTo(bySession, sessionId, socket);
+    },
+
+    /**
+     * 닫힌 연결을 목록에서 뺍니다. 연결의 `close` 이벤트에서 호출하며,
+     * 그 연결의 경기 구독과 입력 권한도 모두 해제합니다.
+     */
+    remove(sessionId: string, socket: WebSocket) {
+      deleteFrom(bySession, sessionId, socket);
+      for (const matchId of matchesOf.get(socket) ?? []) {
+        unsubscribe(matchId, socket);
+      }
+    },
+
+    /**
+     * 세션의 연결을 모두 닫고 목록에서 지웁니다.
+     *
+     * @param code - WebSocket close code (로그아웃은 4401)
+     */
+    closeSession(sessionId: string, code: number, reason: string) {
+      const sockets = bySession.get(sessionId);
+      bySession.delete(sessionId);
+      for (const socket of sockets ?? []) socket.close(code, reason);
+    },
+
+    /**
+     * 연결을 경기 구독자로 등록하고, 그 사용자의 입력 권한 연결로 정합니다.
+     *
+     * @returns 입력 권한을 잃은 이전 연결. 없거나 같은 연결이면 `undefined`
+     *
+     * @remarks
+     * FR-MATCH-02: 경기·사용자마다 마지막으로 구독한 연결 하나만 명령을 보낼 수
+     * 있습니다. 이전 연결은 구독을 유지해 갱신은 계속 받습니다. 참가자 확인은
+     * 호출하는 쪽에서 먼저 합니다.
+     */
+    subscribe(matchId: number, userId: number, socket: WebSocket) {
+      addTo(byMatch, matchId, socket);
+      addTo(matchesOf, socket, matchId);
+      const byUser = controllers.get(matchId) ?? new Map<number, WebSocket>();
+      const previous = byUser.get(userId);
+      byUser.set(userId, socket);
+      controllers.set(matchId, byUser);
+      return previous === socket ? undefined : previous;
+    },
+
+    /** 경기 구독과 그 연결의 입력 권한을 해제합니다. 구독하지 않은 연결이면 변화가 없습니다. */
+    unsubscribe,
+
+    isSubscribed(matchId: number, socket: WebSocket) {
+      return byMatch.get(matchId)?.has(socket) ?? false;
+    },
+
+    /** 연결이 구독 중인 경기 ID 목록입니다. 연결을 닫기 전에 읽습니다. */
+    matchesOf(socket: WebSocket) {
+      return [...(matchesOf.get(socket) ?? [])];
+    },
+
+    /** 이 연결이 해당 사용자의 경기 입력 권한 연결인지 확인합니다. */
+    isController(matchId: number, userId: number, socket: WebSocket) {
+      return controllers.get(matchId)?.get(userId) === socket;
+    },
+
+    /**
+     * 경기 상태 갱신을 한 번만 직렬화해 경기 구독자 전체에 보냅니다.
+     *
+     * @param stateVersion - 메시지에 담긴 snapshot의 버전
+     * @returns 보냈으면 `true`. 구독자가 없거나 같거나 높은 버전을 이미 보냈으면 `false`
+     *
+     * @remarks
+     * `apply()` 결과가 돌아오는 순서는 commit 순서와 다를 수 있습니다. 경기마다
+     * 마지막으로 보낸 버전을 기억해, 버전이 줄어드는 갱신을 보내지 않습니다
+     * (SDS 12번). 다른 경기의 구독자에게는 보내지 않습니다.
+     */
+    broadcastUpdate(matchId: number, stateVersion: number, message: object) {
+      const sockets = byMatch.get(matchId);
+      if (!sockets || stateVersion <= (sentVersions.get(matchId) ?? -1)) {
+        return false;
+      }
+      sentVersions.set(matchId, stateVersion);
+      const data = JSON.stringify(message);
+      for (const socket of sockets) socket.send(data);
+      return true;
+    },
+
+    /**
+     * 경기 상태와 무관한 이벤트(이탈·복귀 알림 등)를 경기 구독자 전체에
+     * 보냅니다. 버전 순서 검사를 하지 않습니다.
+     */
+    broadcastEvent(matchId: number, message: object) {
+      const data = JSON.stringify(message);
+      for (const socket of byMatch.get(matchId) ?? []) socket.send(data);
+    },
+  };
+}
+
+export type ConnectionRegistry = ReturnType<typeof createConnectionRegistry>;
